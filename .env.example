NODE_ENV=development

DATABASE_URL=postgresql://dating:dating@localhost:5432/dating?schema=public
DIRECT_DATABASE_URL=postgresql://dating:dating@localhost:5432/dating?schema=public

REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Dating Platform <no-reply@dating.local>"

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=dating-storage
STORAGE_SECRET_KEY=dating-storage-secret
STORAGE_UPLOAD_BUCKET=dating-uploads
STORAGE_MEDIA_BUCKET=dating-media
STORAGE_PUBLIC_URL=http://localhost:9000/dating-media
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_PROVISION=true
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/dating-media

# Şimdilik yalnızca "mock" (production'da kullanılamaz). Webhook secret en az 32 karakter;
# development'ta boş bırakılırsa her açılışta rastgele üretilir, production'da zorunludur.
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Telefondan açılan doğrulama mailleri. Boşsa NEXT_PUBLIC_APP_URL kullanılır.
EMAIL_LINK_ORIGIN=
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
API_PORT=4000

SENTRY_DSN=

# Web Push (VAPID). Üretmek için: pnpm --filter @dating/api exec web-push generate-vapid-keys
# Boş bırakılırsa push bildirimleri devre dışı kalır; in-app bildirimler çalışmaya devam eder.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@dating.local
